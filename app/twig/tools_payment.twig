{% extends "page.twig" %}

{% block title %}{{ 'tools_payment.title'|trans }} — {{ 'nav.tools.title'|trans }}{% endblock %}

{% block breadcrumbs %}
    <li><a href="/" aria-current="page">{{ 'common.short_name'|trans }}</a></li>
    <li><a href="/tools" aria-current="page">{{ 'nav.tools.title'|trans }}</a></li>
    <li class="is-active"><a href="#" aria-current="page">{{ 'tools_payment.title'|trans }}</a></li>
{% endblock %}

{% block content %}
    <h1 class="title">{{ 'tools_payment.title'|trans }}</h1>
    <p class="block">{{ 'tools_payment.description'|trans }}</p>
    <p class="block">
        {{ 'tools_payment.account'|trans }}
        {{ include('account_link.twig', {data: account}, with_context = false) }}
    </p>

    {% for error in errors %}
        <div class="notification is-danger">{{ error }}</div>
    {% endfor %}

    {% if preview and signing_form %}
        <section class="block" data-payment-result>
            <h2 class="title is-3">{{ 'tools_payment.preview.title'|trans }}</h2>
            <div class="content">
                <ul>
                    <li>{{ 'tools_payment.preview.operations'|trans({'%number%': preview.operation_count}) }}</li>
                    <li>{{ 'tools_payment.preview.max_fee'|trans({'%fee%': preview.max_fee}) }}</li>
                    <li>
                        {{ 'tools_payment.preview.memo'|trans }}
                        {{ ('tools_payment.memo.type.' ~ preview.memo.type)|trans }}{% if preview.memo.value is not null %}: <code>{{ preview.memo.value }}</code>{% endif %}
                    </li>
                </ul>
            </div>

            {% for payment in preview.payments %}
                <article class="message">
                    <div class="message-header">
                        <p>{{ 'tools_payment.form.payment'|trans({'%number%': loop.index}) }}</p>
                    </div>
                    <div class="message-body">
                        {{ include('operations/payment.twig', {op: payment.operation}, with_context = false) }}
                        {% if payment.is_muxed %}
                            <p class="mt-2">
                                {{ 'tools_payment.preview.muxed_destination'|trans }}
                                <code>{{ payment.destination }}</code>
                            </p>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}

            {{ signing_form|raw }}
        </section>
    {% endif %}

    <div class="notification is-warning is-hidden" data-payment-stale>
        {{ 'tools_payment.preview.stale'|trans }}
    </div>

    <form method="post" action="/tools/payment" data-payment-form data-source-account="{{ source_account_id|e('html_attr') }}">
        {% if current_account_param %}
            <input type="hidden" name="current_account" value="{{ current_account_param|e('html_attr') }}">
        {% endif %}

        <div class="field">
            <label class="label" for="payment_memo">{{ 'tools_payment.form.memo'|trans }}</label>
            <div class="control">
                <input
                    class="input"
                    id="payment_memo"
                    name="memo_value"
                    value="{{ memo_value|e('html_attr') }}"
                    maxlength="71"
                    autocomplete="off"
                    data-payment-memo
                >
            </div>
            <p class="help">{{ 'tools_payment.form.memo_help'|trans }}</p>
        </div>

        <div class="block" data-payment-rows>
            {% for payment in payments %}
                {{ include('components/payment_row.twig', {
                    payment_index: loop.index0,
                    payment_number: loop.index,
                    payment: payment,
                    tokens: tokens,
                    payment_errors: row_errors[loop.index0]|default([]),
                    can_remove: payments|length > 1,
                }, with_context = false) }}
            {% endfor %}
        </div>

        <template data-payment-row-template>
            {{ include('components/payment_row.twig', {
                payment_index: '__INDEX__',
                payment_number: '__NUMBER__',
                payment: {destination: '', asset: '', amount: ''},
                tokens: tokens,
                payment_errors: [],
                can_remove: true,
            }, with_context = false) }}
        </template>

        <div class="field is-grouped is-grouped-multiline is-align-items-center mb-5">
            <div class="control">
                <button
                    class="button is-info is-outlined"
                    type="submit"
                    name="action"
                    value="add"
                    formnovalidate
                    data-payment-add
                    {% if payments|length >= max_operations %}disabled{% endif %}
                >
                    <span class="icon"><i class="fa-solid fa-plus" aria-hidden="true"></i></span>
                    <span>{{ 'tools_payment.form.add'|trans }}</span>
                </button>
            </div>
            <div class="control">
                <span class="tag" data-payment-counter data-max-operations="{{ max_operations }}">
                    {{ 'tools_payment.form.operations_counter'|trans({
                        '%number%': payments|length,
                        '%maximum%': max_operations,
                    }) }}
                </span>
            </div>
        </div>

        <div class="field">
            <div class="control">
                <button
                    class="button is-primary"
                    type="submit"
                    name="action"
                    value="build"
                    {% if tokens is empty %}disabled{% endif %}
                >
                    <span class="icon"><i class="fa-solid fa-file-signature" aria-hidden="true"></i></span>
                    <span>{{ 'tools_payment.form.build'|trans }}</span>
                </button>
            </div>
        </div>

        <input type="hidden" name="form_complete" value="1">
    </form>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('[data-payment-form]');
            if (!form) {
                return;
            }

            const rowsRoot = form.querySelector('[data-payment-rows]');
            const rowTemplate = form.querySelector('[data-payment-row-template]');
            const addButton = form.querySelector('[data-payment-add]');
            const counter = form.querySelector('[data-payment-counter]');
            const result = document.querySelector('[data-payment-result]');
            const stale = document.querySelector('[data-payment-stale]');
            const maxOperations = Number(counter ? counter.dataset.maxOperations : 100) || 100;
            const issuerBalanceLabel = {{ 'tools_payment.form.issuer_balance'|trans|json_encode|raw }};
            const scale = 10000000n;
            const feePerOperation = 10000n;
            const maximumStroops = 9223372036854775807n;
            let nextIndex = rowsRoot.querySelectorAll('[data-payment-row]').length;

            function decimalToScaled(value) {
                const normalized = String(value || '').trim().replace(',', '.');
                if (!/^\d+(?:\.\d{0,7})?$/.test(normalized)) {
                    return null;
                }
                const parts = normalized.split('.');
                return BigInt(parts[0]) * scale + BigInt((parts[1] || '').padEnd(7, '0'));
            }

            function formatScaled(value) {
                if (value < 0n) {
                    value = 0n;
                }
                const integer = value / scale;
                const fraction = String(value % scale).padStart(7, '0').replace(/0+$/, '');
                return fraction === '' ? String(integer) : String(integer) + '.' + fraction;
            }

            function selectedOption(row) {
                const select = row.querySelector('[data-payment-asset]');
                return select && select.selectedOptions.length ? select.selectedOptions[0] : null;
            }

            function rowMaximum(row) {
                const option = selectedOption(row);
                if (!option || option.dataset.unlimited === '1') {
                    return null;
                }

                let available = decimalToScaled(option.dataset.available || '0') || 0n;
                const rows = Array.from(rowsRoot.querySelectorAll('[data-payment-row]'));
                if (option.dataset.native === '1') {
                    available -= BigInt(rows.length) * feePerOperation;
                }

                const asset = row.querySelector('[data-payment-asset]').value;
                const sourceAccount = form.dataset.sourceAccount || '';
                const rowIndex = rows.indexOf(row);
                let priorOutgoing = 0n;
                rows.forEach(function (otherRow, otherIndex) {
                    if (otherRow === row) {
                        return;
                    }
                    const otherAsset = otherRow.querySelector('[data-payment-asset]');
                    const otherAmount = otherRow.querySelector('[data-payment-amount]');
                    const otherDestination = otherRow.querySelector('[data-payment-destination]');
                    if (!otherAsset || !otherAmount || otherAsset.value !== asset) {
                        return;
                    }
                    if (otherDestination && otherDestination.value.trim().toUpperCase() === sourceAccount) {
                        return;
                    }
                    const scaled = decimalToScaled(otherAmount.value);
                    if (scaled !== null) {
                        available -= scaled;
                        if (otherIndex < rowIndex) {
                            priorOutgoing += scaled;
                        }
                    }
                });

                const destination = row.querySelector('[data-payment-destination]');
                const destinationIsSource = destination
                    && destination.value.trim().toUpperCase() === sourceAccount;
                if (destinationIsSource) {
                    if (available < 0n) {
                        return 0n;
                    }
                    if (option.dataset.native === '1') {
                        return maximumStroops;
                    }
                    const receiveCapacity = decimalToScaled(option.dataset.selfReceiveCapacity || '0') || 0n;
                    const maximum = receiveCapacity + priorOutgoing;
                    return maximum < maximumStroops ? maximum : maximumStroops;
                }

                return available > 0n ? available : 0n;
            }

            function syncAssetDetails(row) {
                const option = selectedOption(row);
                if (!option) {
                    return;
                }
                const unlimited = option.dataset.unlimited === '1';
                const maximum = rowMaximum(row);
                const balance = row.querySelector('[data-payment-balance]');
                const maximumLabels = row.querySelectorAll('[data-payment-maximum]');
                const maximumStatic = row.querySelector('[data-payment-max-static]');
                const maxButton = row.querySelector('[data-payment-max]');
                const frozenLabels = row.querySelectorAll('[data-payment-frozen]');
                const frozenOrders = row.querySelector('[data-payment-frozen-orders]');
                const frozenAccount = row.querySelector('[data-payment-frozen-account]');
                const frozen = decimalToScaled(option.dataset.frozen || '0') || 0n;

                if (balance) balance.textContent = unlimited ? issuerBalanceLabel : formatScaled(decimalToScaled(option.dataset.balance || '0') || 0n);
                maximumLabels.forEach(function (label) {
                    label.textContent = unlimited ? '∞' : formatScaled(maximum || 0n);
                });
                if (maximumStatic) maximumStatic.classList.add('is-hidden');
                if (maxButton) {
                    maxButton.classList.remove('is-hidden');
                    maxButton.disabled = unlimited || maximum === null || maximum <= 0n;
                }
                frozenLabels.forEach(function (label) {
                    label.textContent = formatScaled(frozen);
                });
                if (frozenOrders) frozenOrders.classList.toggle('is-hidden', frozen === 0n || option.dataset.frozenKind !== 'orders');
                if (frozenAccount) frozenAccount.classList.toggle('is-hidden', frozen === 0n || option.dataset.frozenKind !== 'account');
            }

            function markResultStale() {
                if (!result || result.classList.contains('is-hidden')) {
                    return;
                }
                result.classList.add('is-hidden');
                if (stale) stale.classList.remove('is-hidden');
            }

            function syncRows() {
                const rows = Array.from(rowsRoot.querySelectorAll('[data-payment-row]'));
                rows.forEach(function (row, index) {
                    const header = row.querySelector('[data-payment-row-header]');
                    const number = row.querySelector('[data-payment-row-title]');
                    const remove = row.querySelector('[data-payment-remove]');
                    if (header) {
                        header.classList.toggle('is-flex', rows.length > 1);
                        header.classList.toggle('is-hidden', rows.length <= 1);
                    }
                    if (number) {
                        number.textContent = {{ 'tools_payment.form.payment_js_prefix'|trans|json_encode|raw }} + String(index + 1);
                    }
                    if (remove) {
                        const removeLabel = {{ 'tools_payment.form.remove_js_prefix'|trans|json_encode|raw }} + String(index + 1);
                        remove.disabled = rows.length <= 1;
                        remove.value = String(index);
                        remove.setAttribute('aria-label', removeLabel);
                        remove.title = removeLabel;
                    }
                    syncAssetDetails(row);
                });
                if (counter) {
                    counter.textContent = {{ 'tools_payment.form.operations_counter_js_prefix'|trans|json_encode|raw }}
                        + String(rows.length) + ' / ' + String(maxOperations);
                }
                if (addButton) addButton.disabled = rows.length >= maxOperations;
            }

            rowsRoot.addEventListener('click', function (event) {
                const remove = event.target.closest('[data-payment-remove]');
                if (remove) {
                    const rows = rowsRoot.querySelectorAll('[data-payment-row]');
                    if (rows.length <= 1) {
                        return;
                    }
                    event.preventDefault();
                    remove.closest('[data-payment-row]').remove();
                    markResultStale();
                    syncRows();
                    return;
                }

                const maxButton = event.target.closest('[data-payment-max]');
                if (maxButton) {
                    event.preventDefault();
                    const row = maxButton.closest('[data-payment-row]');
                    const amount = row.querySelector('[data-payment-amount]');
                    const maximum = rowMaximum(row);
                    if (amount && maximum !== null) {
                        amount.value = formatScaled(maximum);
                        amount.dispatchEvent(new Event('input', {bubbles: true}));
                    }
                }
            });

            rowsRoot.addEventListener('input', function (event) {
                if (event.target.matches('[data-payment-amount], [data-payment-destination]')) {
                    markResultStale();
                    syncRows();
                }
            });
            rowsRoot.addEventListener('change', function (event) {
                if (event.target.matches('[data-payment-asset]')) {
                    markResultStale();
                    syncRows();
                }
            });
            form.querySelector('[data-payment-memo]').addEventListener('input', markResultStale);

            if (addButton && rowTemplate) {
                addButton.addEventListener('click', function (event) {
                    const count = rowsRoot.querySelectorAll('[data-payment-row]').length;
                    if (count >= maxOperations) {
                        return;
                    }
                    event.preventDefault();
                    const wrapper = document.createElement('div');
                    wrapper.innerHTML = rowTemplate.innerHTML
                        .replaceAll('__INDEX__', String(nextIndex++))
                        .replaceAll('__NUMBER__', String(count + 1));
                    const row = wrapper.firstElementChild;
                    if (!row) {
                        return;
                    }
                    rowsRoot.appendChild(row);
                    if (typeof window.initAccountAutocompletes === 'function') {
                        window.initAccountAutocompletes(row);
                    }
                    markResultStale();
                    syncRows();
                    const destination = row.querySelector('[data-payment-destination]');
                    if (destination) destination.focus();
                });
            }

            syncRows();
        });
    </script>
{% endblock %}
